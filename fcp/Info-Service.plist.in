<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleDisplayName</key>
	<string>@ANON_APP_NAME@ XPC Service</string>
	<key>CFBundleExecutable</key>
	<string>@ANON_APP_NAME@ XPC Service</string>
	<key>CFBundleIdentifier</key>
	<string>@ANON_ID_FCP_SERVICE@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@ANON_APP_NAME@ XPC Service</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>@ANON_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@ANON_VERSION@</string>
	<key>PlugInKit</key>
	<dict>
		<key>Attributes</key>
		<dict>
			<key>com.apple.protocol</key>
			<string>FxPlug</string>
			<key>com.apple.version</key>
			<string>1.4</string>
		</dict>
		<key>PrincipalClass</key>
		<string>FxPrincipal</string>
		<key>Protocol</key>
		<string>PROXPCProtocol</string>
		<key>Subsystems</key>
		<array>
			<string>NSViewService_PKSubsystem</string>
		</array>
	</dict>
	<key>ProPlugDictionaryVersion</key>
	<string>1.0</string>
	<key>ProPlugDynamicRegistration</key>
	<false/>
	<key>ProPlugPlugInGroupList</key>
	<array>
		<dict>
			<key>groupName</key>
			<string>@ANON_CATEGORY@</string>
			<key>uuid</key>
			<string>@ANON_FX_GROUP_UUID@</string>
		</dict>
	</array>
	<key>ProPlugPlugInList</key>
	<array>
		<dict>
			<key>className</key>
			<string>AnonymizerFxPlugIn</string>
			<key>displayName</key>
			<string>@ANON_EFFECT_NAME@</string>
			<key>group</key>
			<string>@ANON_FX_GROUP_UUID@</string>
			<key>infoString</key>
			<string>Anonymizes a region with stacked distortion, blur and mosaic layers, or solid blackout.</string>
			<key>protocolNames</key>
			<array>
				<string>FxFilter</string>
			</array>
			<key>uuid</key>
			<string>@ANON_FX_PLUGIN_UUID@</string>
			<key>version</key>
			<string>1.4</string>
		</dict>
	</array>
	<key>XPCService</key>
	<dict>
		<key>ServiceType</key>
		<string>Application</string>
		<key>JoinExistingSession</key>
		<true/>
		<key>RunLoopType</key>
		<string>_NSApplicationMain</string>
		<key>_AdditionalSubServices</key>
		<dict>
			<key>viewbridge</key>
			<true/>
		</dict>
	</dict>
</dict>
</plist>
